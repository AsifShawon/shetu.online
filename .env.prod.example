# General
APP_ENV=production
WEB_BASE_URL=https://eduwise.fleeky.online
NEXT_PUBLIC_API_BASE_URL=https://api.eduwise.fleeky.online
SERVER_API_BASE_URL=http://backend:8000

# Ports for FASTPANEL localhost upstreams
FRONTEND_HOST_PORT=3011
BACKEND_HOST_PORT=8011

# MySQL
MYSQL_DATABASE=eduwise
MYSQL_USER=eduwise
MYSQL_PASSWORD=replace_me_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_me_with_a_different_strong_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Django currently reads MYSQL_* variables directly.
DATABASE_URL=mysql://eduwise:replace_me_with_a_strong_password@mysql:3306/eduwise

# Backend
DJANGO_SECRET_KEY=replace_with_long_random_django_secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.eduwise.fleeky.online,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://eduwise.fleeky.online
CSRF_TRUSTED_ORIGINS=https://eduwise.fleeky.online,https://api.eduwise.fleeky.online
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_DOMAIN=.eduwise.fleeky.online
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.eduwise.fleeky.online
RUN_MIGRATIONS=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Legacy-compatible secret placeholders if future code reads them.
SECRET_KEY=replace_with_long_random_secret
JWT_SECRET=replace_with_long_random_secret

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Shetu Support <noreply@shetu.online>
