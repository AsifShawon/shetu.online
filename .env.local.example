# General
APP_ENV=local
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SERVER_API_BASE_URL=http://backend:8000

# Ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
MYSQL_HOST_PORT=3307

# MySQL
MYSQL_DATABASE=eduwise_v3
MYSQL_USER=eduwise
MYSQL_PASSWORD=eduwise_local_password
MYSQL_ROOT_PASSWORD=eduwise_local_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Django currently reads MYSQL_* variables directly.
DATABASE_URL=mysql://eduwise:eduwise_local_password@mysql:3306/eduwise_v3

# Backend
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
RUN_MIGRATIONS=true

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Shetu Support <noreply@shetu.online>
